{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/session-info",
      "destination": "/api/proxy"
    },
    {
      "source": "/session/:path*",
      "destination": "/api/proxy"
    }
  ]
}
