<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284C7"/>
      <stop offset="100%" stop-color="#075985"/>
    </linearGradient>
  </defs>
  <rect width="1600" height="900" fill="url(#bg)"/>
  <!-- BUBBLES -->
  <circle cx="800" cy="480" r="100" fill="#E0F2FE" opacity="0.9" stroke="#38BDF8" stroke-width="8"/>
  <text x="800" y="515" font-family="Arial, sans-serif" font-weight="900" font-size="100" fill="#0369A1" text-anchor="middle">&gt;</text>
  <!-- FISH -->
  <g transform="translate(300, 420)">
    <ellipse cx="100" cy="60" rx="110" ry="70" fill="#F97316" stroke="#C2410C" stroke-width="8"/>
    <polygon points="210,60 280,10 280,110" fill="#EA580C" stroke="#C2410C" stroke-width="8"/>
    <circle cx="50" cy="45" r="15" fill="#FFFFFF"/>
    <circle cx="45" cy="45" r="7" fill="#1E293B"/>
  </g>
  <rect x="350" y="80" width="900" height="130" rx="30" fill="#FFFFFF" opacity="0.95" stroke="#0284C7" stroke-width="8"/>
  <text x="800" y="165" font-family="Arial, sans-serif" font-weight="900" font-size="65" fill="#075985" text-anchor="middle">🐟 CÁ CON SO SÁNH SỐ</text>
</svg>
