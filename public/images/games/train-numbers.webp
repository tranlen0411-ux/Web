<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>
    <linearGradient id="ground" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4ADE80"/>
      <stop offset="100%" stop-color="#16A34A"/>
    </linearGradient>
  </defs>
  <rect width="1600" height="900" fill="url(#bg)"/>
  <circle cx="200" cy="150" r="80" fill="#FDE047" opacity="0.9"/>
  <path d="M 0 650 Q 400 550 800 650 T 1600 650 L 1600 900 L 0 900 Z" fill="url(#ground)"/>
  <!-- TRAIN ENGINE -->
  <rect x="250" y="480" width="220" height="150" rx="20" fill="#EF4444" stroke="#991B1B" stroke-width="8"/>
  <rect x="420" y="400" width="120" height="230" rx="15" fill="#DC2626" stroke="#991B1B" stroke-width="8"/>
  <rect x="440" y="430" width="80" height="70" rx="10" fill="#E0F2FE" stroke="#0284C7" stroke-width="6"/>
  <rect x="290" y="410" width="40" height="70" fill="#475569"/>
  <!-- WHEELS -->
  <circle cx="320" cy="640" r="45" fill="#1E293B" stroke="#F59E0B" stroke-width="8"/>
  <circle cx="480" cy="640" r="45" fill="#1E293B" stroke="#F59E0B" stroke-width="8"/>
  <!-- CAR 1 -->
  <rect x="580" y="500" width="200" height="130" rx="15" fill="#F59E0B" stroke="#B45309" stroke-width="8"/>
  <circle cx="630" cy="640" r="35" fill="#1E293B" stroke="#F59E0B" stroke-width="6"/>
  <circle cx="730" cy="640" r="35" fill="#1E293B" stroke="#F59E0B" stroke-width="6"/>
  <text x="680" y="585" font-family="Arial, sans-serif" font-weight="900" font-size="70" fill="#FFFFFF" text-anchor="middle">1</text>
  <!-- CAR 2 -->
  <rect x="830" y="500" width="200" height="130" rx="15" fill="#10B981" stroke="#047857" stroke-width="8"/>
  <circle cx="880" cy="640" r="35" fill="#1E293B" stroke="#F59E0B" stroke-width="6"/>
  <circle cx="980" cy="640" r="35" fill="#1E293B" stroke="#F59E0B" stroke-width="6"/>
  <text x="930" y="585" font-family="Arial, sans-serif" font-weight="900" font-size="70" fill="#FFFFFF" text-anchor="middle">2</text>
  <!-- CAR 3 -->
  <rect x="1080" y="500" width="200" height="130" rx="15" fill="#8B5CF6" stroke="#6D28D9" stroke-width="8"/>
  <circle cx="1130" cy="640" r="35" fill="#1E293B" stroke="#F59E0B" stroke-width="6"/>
  <circle cx="1230" cy="640" r="35" fill="#1E293B" stroke="#F59E0B" stroke-width="6"/>
  <text x="1180" y="585" font-family="Arial, sans-serif" font-weight="900" font-size="70" fill="#FFFFFF" text-anchor="middle">3</text>
  <!-- TITLE OVERLAY -->
  <rect x="350" y="80" width="900" height="130" rx="30" fill="#FFFFFF" opacity="0.95" stroke="#F59E0B" stroke-width="8"/>
  <text x="800" y="165" font-family="Arial, sans-serif" font-weight="900" font-size="65" fill="#78350F" text-anchor="middle">🚂 ĐOÀN TÀU SỐ HỌC</text>
</svg>
